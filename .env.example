# ─────────────────────────────────────────────────────────────────────────────
# .env.example — IRO Strength Velocity v7.0.0
# CORRECTIF SEC-01/SEC-02/SEC-03
#
# RÈGLE ABSOLUE :
#   Variables SERVER  → lues uniquement par Node.js / server.ts
#   Variables CLIENT  → préfixe VITE_*, uniquement des informations publiques
#
# Architecture de sécurité :
#   Browser → /api/llm (Express) → Gemini (Exclusive Provider)
#   Browser → /api/pappers (Express) → Pappers.fr
#   Browser → /api/press/search (Express) → GDELT + NewsAPI (v8.0)
#   Les clés ne transitent JAMAIS vers le bundle JavaScript client.
#
# Usage : cp .env.example .env  puis remplir les valeurs
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVEUR UNIQUEMENT — ne jamais préfixer VITE_ ─────────────────────────────

# LLM Provider (Exclusive)
GEMINI_API_KEY=           # Google AI Studio — https://aistudio.google.com/apikey
# ANTHROPIC/MISTRAL : Non supportés dans cette version (Gemini Exclusive)

# Collecteurs de données
GITHUB_TOKEN=             # https://github.com/settings/tokens (scope: public_repo)
PAPPERS_API_KEY=          # https://www.pappers.fr/api (gratuit avec inscription)
CRUNCHBASE_API_KEY=       # https://data.crunchbase.com (~500$/an)
PROXYCURL_API_KEY=        # LinkedIn via ProxyCurl (~0.01$/profil)
INPI_API_KEY=             # https://data.inpi.fr (gratuit)
INSEE_API_KEY=            # https://api.insee.fr (gratuit)
NEWSAPI_KEY=              # https://newsapi.org (optionnel — complément GDELT pour Presse Intelligence v8.0)

# Serveur
NODE_ENV=development
PORT=3000
INTERNAL_API_KEY=         # Clé API protégeant TOUTES les routes /api sensibles (sauf /health et /metrics). Fortement recommandé en production.
ALLOWED_ORIGINS=          # Origines CORS autorisées, séparées par des virgules. OBLIGATOIRE en production (fail-closed sinon).
EMBED_ANCESTORS=          # Optionnel : origines autorisées à embarquer l'app en iframe (ex: https://aistudio.google.com). Défaut : 'self' uniquement.
ALLOW_MOCK_FALLBACK=      # 'true' pour activer les réponses LLM simulées en cas d'échec Gemini (DEV/DÉMO UNIQUEMENT — jamais en production).

# ── CLIENT UNIQUEMENT — préfixe VITE_*, informations non-sensibles ─────────────

VITE_APP_VERSION=7.0.0
VITE_APP_NAME=IRO Strength Velocity

# ─────────────────────────────────────────────────────────────────────────────
# NE JAMAIS METTRE dans les variables VITE_* :
#   VITE_GEMINI_API_KEY    ← exposé dans le bundle JS
#   VITE_PAPPERS_API_KEY   ← exposé dans le bundle JS
#   VITE_GITHUB_TOKEN      ← exposé dans le bundle JS
# ─────────────────────────────────────────────────────────────────────────────
