{
  "name": "irostrength-velocity",
  "private": true,
  "version": "7.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "collect": "tsx src/index.ts collect",
    "score": "tsx src/index.ts score",
    "sce": "tsx src/index.ts sce",
    "validate": "tsx src/index.ts validate",
    "freeze": "tsx src/index.ts freeze",
    "r2": "tsx src/index.ts r2",
    "status": "tsx src/index.ts status",
    "batch": "tsx src/index.ts batch",
    "batch-iro": "tsx src/commands/batch_iro.ts",
    "pipeline:n1000": "tsx src/collectors/pipeline-n1000.ts",
    "pipeline:n1000:dry": "tsx src/collectors/pipeline-n1000.ts --dry",
    "score:manual": "tsx src/index.ts score"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.0.0",
    "html2canvas": "^1.4.1",
    "inquirer": "^13.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ora": "^9.3.0",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "serpapi": "^2.2.1",
    "simple-statistics": "^7.8.9",
    "sql.js": "^1.14.1",
    "tsx": "^4.21.0",
    "vite": "6.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.9",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "3.2.6",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.25.0",
    "msw": "^2.14.6",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "path-to-regexp": ">=0.1.13 <0.2.0",
    "protobufjs": ">=7.5.6",
    "esbuild": "0.25.0",
    "vite": "6.4.3",
    "vitest": "3.2.6",
    "@vitest/coverage-v8": "3.2.6"
  }
